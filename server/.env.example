PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/fitness_monitor
JWT_SECRET=replace_with_a_long_random_string_of_32_or_more_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_SAMESITE=lax
# Optional SMTP (password reset emails). Leave SMTP_HOST empty in development:
# the reset link is printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FitTrack <no-reply@example.com>
