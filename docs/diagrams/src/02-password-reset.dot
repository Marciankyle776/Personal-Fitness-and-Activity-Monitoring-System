// 02  Password reset
// Notation: green rounded = start/end | white = screen or user step | blue = API/server step
//           amber diamond = decision | purple cylinder = database | red dashed = error or recovery
//           grey parallelogram = user input.   Render with: sh scripts/render-diagrams.sh
digraph G {
  graph [rankdir=TB, fontname="Helvetica,Arial,sans-serif", fontsize=18, labelloc=t, pad=0.3, nodesep=0.45, ranksep=0.5, splines=polyline];
  node  [fontname="Helvetica,Arial,sans-serif", fontsize=11, color="#1f2937", penwidth=1.2, margin="0.16,0.08"];
  edge  [fontname="Helvetica,Arial,sans-serif", fontsize=10, color="#374151", arrowsize=0.8];

  label="02  Password reset";
  start [shape=box, style="rounded,filled", fillcolor="#d1fae5", label="User chooses\nForgot password"];
  in1 [shape=parallelogram, style="filled", fillcolor="#f1f5f9", label="Enter email address"];
  v1 [shape=diamond, style="filled", fillcolor="#fef3c7", label="Valid email format?"];
  e1 [shape=box, style="filled,dashed", fillcolor="#fee2e2", label="Inline error"];
  p1 [shape=box, style="filled", fillcolor="#e0f2fe", label="POST /api/auth/forgot-password\n(limit: 5 per hour)"];
  ex [shape=diamond, style="filled", fillcolor="#fef3c7", label="Account exists?"];
  tok [shape=cylinder, style="filled", fillcolor="#ede9fe", label="users: store SHA-256 hash of a random\ntoken, valid for 15 minutes"];
  mail [shape=diamond, style="filled", fillcolor="#fef3c7", label="Email sent?\n(development without SMTP:\nlink shown on page and in console)"];
  fm [shape=box, style="filled,dashed", fillcolor="#fee2e2", label="Token removed,\nuser still sees the same reply"];
  same [shape=box, style="filled", fillcolor="#ffffff", label="Same message for every address:\n'If an account exists, a link was sent'"];
  open [shape=parallelogram, style="filled", fillcolor="#f1f5f9", label="User opens\n/reset-password?token=..."];
  tl [shape=diamond, style="filled", fillcolor="#fef3c7", label="Token present and\n64 characters?"];
  inv [shape=box, style="filled,dashed", fillcolor="#fee2e2", label="Invalid link page:\nrequest a new link"];
  in2 [shape=parallelogram, style="filled", fillcolor="#f1f5f9", label="Enter new password\nand confirmation"];
  v2 [shape=diamond, style="filled", fillcolor="#fef3c7", label="Client validation OK?\n(strength rules, match)"];
  e2 [shape=box, style="filled,dashed", fillcolor="#fee2e2", label="Inline field errors"];
  p2 [shape=box, style="filled", fillcolor="#e0f2fe", label="POST /api/auth/reset-password"];
  chk [shape=diamond, style="filled", fillcolor="#fef3c7", label="Token hash matches\nand not expired?"];
  e400 [shape=box, style="filled,dashed", fillcolor="#fee2e2", label="400: link invalid or expired,\nrequest a new link"];
  save [shape=cylinder, style="filled", fillcolor="#ede9fe", label="users: new bcrypt hash, passwordChangedAt,\ntoken cleared\nnotifications: password changed"];
  old [shape=box, style="filled", fillcolor="#e0f2fe", label="Sessions issued before the change\nare rejected on their next request"];
  done [shape=box, style="rounded,filled", fillcolor="#d1fae5", label="Toast, then Sign in page"];
  start -> in1;
  in1 -> v1;
  v1 -> e1 [label="No"];
  e1 -> in1;
  v1 -> p1 [label="Yes"];
  p1 -> ex;
  ex -> same [label="No"];
  ex -> tok [label="Yes"];
  tok -> mail;
  mail -> same [label="Yes"];
  mail -> fm [label="No"];
  fm -> same;
  same -> open [label="Later, from the email"];
  open -> tl;
  tl -> inv [label="No"];
  tl -> in2 [label="Yes"];
  in2 -> v2;
  v2 -> e2 [label="No"];
  e2 -> in2;
  v2 -> p2 [label="Yes"];
  p2 -> chk;
  chk -> e400 [label="No"];
  e400 -> inv;
  chk -> save [label="Yes"];
  save -> old;
  old -> done;
}
